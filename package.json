{
  "name": "review-dojo",
  "version": "0.1.0",
  "private": true,
  "description": "Guided, comprehension-first pull request review.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:app": "tsx e2e/harness/cli.ts",
    "cli": "tsx src/cli.ts",
    "package": "electron-vite build && electron-builder --mac",
    "format": "prettier --write src e2e electron.vite.config.ts"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@pierre/diffs": "^1.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@openai/codex-sdk": "^0.157.1",
    "zod": "^4.6.5"
  },
  "productName": "Review Dojo"
}
