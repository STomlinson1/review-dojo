#!/usr/bin/env python3
"""Print recorded worker costs, per ticket and in total.

usage: cost [TICKET]
"""

from __future__ import annotations

import sys
from collections import defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from lib import main_checkout

ledger = main_checkout() / ".sdd" / "costs.tsv"
only = sys.argv[1] if len(sys.argv) > 1 else None
totals: dict[str, float] = defaultdict(float)
unread: dict[str, int] = defaultdict(int)
for line in ledger.read_text().splitlines() if ledger.exists() else []:
    _, ticket, _, amount = line.split("\t")
    if only and ticket != only:
        continue
    if amount == "unread":
        unread[ticket] += 1
    else:
        totals[ticket] += float(amount)
for ticket in sorted(set(totals) | set(unread)):
    missing = f" (+{unread[ticket]} workers unread)" if unread[ticket] else ""
    print(f"{ticket}\t${totals[ticket]:.2f}{missing}")
