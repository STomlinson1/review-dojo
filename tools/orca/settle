#!/usr/bin/env python3
"""Settle one finished worker: record its session cost, release it, acknowledge its delivery.

usage: settle TICKET LABEL DISPATCH DELIVERY HANDLE

The cost is read before the release because a released terminal exits and its status line is gone.
It is appended to .sdd/costs.tsv in the main checkout, whichever worktree this runs from.
"""

from __future__ import annotations

import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from lib import fail, main_checkout, orca, session_cost

if len(sys.argv) != 6:
    fail(__doc__)
ticket, label, dispatch, delivery, handle = sys.argv[1:]

cost = session_cost(handle)
ledger = main_checkout() / ".sdd" / "costs.tsv"
ledger.parent.mkdir(exist_ok=True)
with ledger.open("a") as f:
    f.write(f"{date.today().isoformat()}\t{ticket}\t{label}\t{cost or 'unread'}\n")
print("cost", f"${cost}" if cost else "UNREAD (status line not found; recorded as unread)")

release = orca("orchestration", "worker-release", "--dispatch", dispatch).get("result") or {}
print("release", release.get("state"), release.get("reason") or "")
print("ack", orca("orchestration", "check", "--ack", delivery).get("ok"))
