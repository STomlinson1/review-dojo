{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    "src/shared/**/*.test.ts"
  ]
}
